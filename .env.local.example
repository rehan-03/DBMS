# ── MongoDB ──────────────────────────────────────────────────────────────────
# Your MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Database name (default: campulse)
MONGODB_DB=campulse
# Optional: override Node DNS for Atlas SRV lookup issues on your network.
# MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8

# ── NextAuth ──────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=your-strong-random-secret-here
NEXTAUTH_URL=http://localhost:3000

# Show one-click sample-account buttons in an explicitly enabled demo build.
# Seed an empty demonstration database first; keep false for real accounts.
NEXT_PUBLIC_DEMO_MODE=false

# Optional: natural-language filters in the faculty/HOD database explorer.
GEMINI_API_KEY=
